{
  "name": "desk-companion",
  "productName": "Desk Companion",
  "version": "0.3.1",
  "description": "Tray companion that reminds you to drink water, move, eat and go home.",
  "main": "src/main/main.js",
  "author": "sunil8113",
  "license": "MIT",
  "repository": "github:sunil8113/desktop-companion",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "icons": "node scripts/make-icons.js",
    "cutout": "node scripts/cutout.js",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.sunil8113.desktopcompanion",
    "productName": "Desk Companion",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "sunil8113",
      "repo": "desktop-companion"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "Desk-Companion-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "artifactName": "Desk-Companion-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
